[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Refreshing Quickshell update indicator...
When = PostTransaction
Exec = /usr/bin/sh -c 'sudo -u walarch XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-1 /usr/bin/quickshell -c /home/walarch/.config/quickshell/walarch-shell ipc call updates refresh || true'

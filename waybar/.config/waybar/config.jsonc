{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 4,
    "exclusive": true,
    "gtk-layer-shell": true,
    "passthrough": false,
    "fixed-center": true,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "network", "custom/power"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "",
            "default": "",
            "empty": ""
        },
        "persistent-workspaces": {
            "*": 4
        }
    },

    "hyprland/window": {
        "format": " {title} ",
        "max-length": 40,
        "rewrite": {
            "": " 󰇄 Desktop "
        }
    },

    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ebdbb2'><b>{}</b></span>",
                "days": "<span color='#ebdbb2'><b>{}</b></span>",
                "today": "<span color='#458588'><b><u>{}</u></b></span>"
            }
        }
    },

    "cpu": {
        "format": "  {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "  {}%",
        "interval": 2
    },

    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "󰈀  Wired",
        "format-disconnected": "󰤭  Offline",
        "tooltip-format": "{essid} - {ifname} via {gwaddr}"
    },

    "custom/power": {
        "format": " ",
        "on-click": "wlogout --buttons-per-row 5 --protocol layer-shell",
        "tooltip": false
    }
}

{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 4,
    "exclusive": true,
    "gtk-layer-shell": true,
    "passthrough": false,
    "fixed-center": true,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "custom/updates", "custom/network", "pulseaudio", "custom/power"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "",
            "default": "",
            "empty": ""
        },
        "persistent-workspaces": {
            "*": 4
        }
    },

    "hyprland/window": {
        "format": " {title} ",
        "max-length": 40,
        "rewrite": {
            "": " 󰇄 Desktop "
        }
    },

    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ebdbb2'><b>{}</b></span>",
                "days": "<span color='#ebdbb2'><b>{}</b></span>",
                "today": "<span color='#458588'><b><u>{}</u></b></span>"
            }
        }
    },

    "cpu": {
        "format": "  {usage}%",
        "interval": 2,
        "states": {
            "warning": 75,
            "critical": 90
        }
    },

    "memory": {
        "format": "  {}%",
        "interval": 2,
        "states": {
            "warning": 75,
            "critical": 90
        }
    },

    "custom/updates": {
        "format": "{icon}{text}",
        "format-icons": {
            "clean": "",
            "pending": ""
        },
        "exec": "$HOME/.config/waybar/scripts/updates.sh",
        "return-type": "json",
        "interval": 1800,
        "signal": 8,
        "on-click": "kitty -e bash -c 'if command -v yay &>/dev/null; then yay -Syu; elif command -v paru &>/dev/null; then paru -Syu; else sudo pacman -Syu; fi; echo; read -n1 -p \"Press any key to close...\"'",
        "tooltip": true
    },

    "custom/network": {
        "exec": "$HOME/.config/waybar/scripts/netspeed.sh",
        "return-type": "json",
        "tooltip": true
    },

    "pulseaudio": {
        "format": "  {volume}%",
        "format-muted": " Muted",
        "scroll-step": 5,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "custom/power": {
        "format": " ",
        "on-click": "wlogout --buttons-per-row 5 --protocol layer-shell",
        "tooltip": false
    }
}
